programa {
  funcao inicio() {
  inteiro n1,n2 
  escreva("Digite o primeiro numero: ") 
  leia(n1) 
  escreva("Digite o segundo numero: ")
  leia(n2)
  se(n1 > n2)
  escreva("O primeiro numero é maior")
  senao se (n2 > n1)
  escreva("O segundo numero é maior")
  senao
  escreva("Os numeros são iguais")
  }
}
